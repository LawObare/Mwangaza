# Environment variables for Mwangaza backend (SQLite version).
#
# Server
PORT=8080
DATABASE_PATH=./data/lakenet.db

# SpaceIoTBox API
SPACEIOTBOX_API_KEY=
SPACEIOTBOX_BASE_URL=

# Mock mode — set to "true" for development without live APIs
USE_MOCK_DATA=true

# Africa's Talking SMS
SMS_API_KEY=
SMS_USERNAME=

# JWT secret for authentication tokens
JWT_SECRET=mwangaza-dev-secret-change-in-production