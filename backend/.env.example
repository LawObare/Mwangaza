# Server
PORT=8080
DATABASE_PATH=./data/lakenet.db
USE_MOCK_DATA=true

# Kijani farm/environment data. Use the exact endpoint supplied by Kijani.
# The authenticated Flutter user's bearer token is forwarded automatically.
# KIJANI_API_KEY is only needed for server-initiated jobs such as auto-alerts.
KIJANI_DATA_URL=https://api.kijanispace.eu/v1/agro_climate/land
KIJANI_API_KEY=

# Africa's Talking
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=Mwangaza
