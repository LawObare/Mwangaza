# Server
PORT=8080
DATABASE_PATH=./data/lakenet.db
USE_MOCK_DATA=true

# Weather data provider (OpenWeatherMap). The API key is sent as the `appid`
# query parameter and never as an auth header. KIJANI_DATA_URL /
# KIJANI_API_KEY are accepted as legacy aliases.
WEATHER_DATA_URL=https://api.openweathermap.org/data/2.5/forecast
WEATHER_API_KEY=

# Secret used to sign locally issued JWTs for /api/auth/*.
# Leave blank in development to use the built-in dev secret.
JWT_SECRET=

# Africa's Talking
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=Mwangaza
