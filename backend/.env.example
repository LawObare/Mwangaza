# Environment variables for Mwangaza backend (SQLite version).
#
# Server
PORT=8080
DATABASE_PATH=./data/lakenet.db

# SpaceIoTBox API
SPACEIOTBOX_API_KEY=your_api_key_here
SPACEIOTBOX_BASE_URL=https://api.spaceiotbox.com/v1/data

# Mock mode — set to "true" for development without live APIs
USE_MOCK_DATA=true

# Africa's Talking SMS
SMS_API_KEY=your_sms_api_key_here